# ---- Xero OAuth 2.0 app (create at developer.xero.com → My Apps → Web app) ----
# Redirect URI on the app MUST be exactly:
#   http://localhost:8000/auth/xero/callback
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:8000/auth/xero/callback
# Optional override — defaults to broad scopes (valid until Sept 2027).
# Swap for the granular scopes listed on developer.xero.com when confirmed.
# XERO_SCOPES=offline_access openid profile email accounting.settings accounting.contacts accounting.transactions

# ---- Anthropic (mapping/ingest/matching engines) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Token encryption at rest ----
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CANOPY_FERNET_KEY=

# ---- Storage ----
DATABASE_URL=sqlite:///./canopy.sqlite3

# ---- Misc ----
SNAPSHOT_TTL_SECONDS=300
FRONTEND_ORIGIN=http://localhost:3000
