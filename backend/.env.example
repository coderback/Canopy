# ---- Xero OAuth 2.0 app (create at developer.xero.com → My Apps → Web app) ----
# Redirect URI on the app MUST be exactly:
#   http://localhost:8000/auth/xero/callback
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:8000/auth/xero/callback
# Optional override — defaults to granular scopes (the broad accounting.transactions
# was deprecated in Xero's 2 Mar 2026 change; apps created since can ONLY request
# granular scopes, else the authorize call fails with invalid_scope). The granular
# replacement for the ManualJournals write endpoint is accounting.manualjournals.
# XERO_SCOPES=offline_access openid profile email accounting.settings accounting.contacts accounting.manualjournals

# ---- LLM: Azure AI Foundry via the OpenAI SDK (mapping/ingest/matching engines) ----
# LLM_PROVIDER options:
#   azure_ad — Foundry /openai/v1 endpoint + Entra ID (DefaultAzureCredential, no key;
#              run `az login`). This is our setup.
#   azure    — classic AzureOpenAI with an api key + api version.
#   openai   — any OpenAI-compatible endpoint via OPENAI_* below.
LLM_PROVIDER=azure_ad

# azure_ad (and azure): endpoint + deployment
AZURE_OPENAI_ENDPOINT=          # https://<resource>.services.ai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=        # the model deployment name (e.g. gpt-5.4-mini)
AZURE_AD_SCOPE=https://ai.azure.com/.default

# azure (api-key mode) only:
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# openai (generic) mode only:
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o

# gpt-5-class models reject non-default temperature — leave unset to omit it.
# LLM_TEMPERATURE=0

# ---- Token encryption at rest ----
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CANOPY_FERNET_KEY=

# ---- Storage ----
DATABASE_URL=sqlite:///./canopy.sqlite3

# ---- Misc ----
SNAPSHOT_TTL_SECONDS=300
FRONTEND_ORIGIN=http://localhost:3000
