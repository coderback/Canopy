# ---- Xero OAuth 2.0 app (create at developer.xero.com → My Apps → Web app) ----
# Redirect URI on the app MUST be exactly:
#   http://localhost:8000/auth/xero/callback
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:8000/auth/xero/callback
# Optional override — defaults to broad scopes (valid until Sept 2027).
# Swap for the granular scopes below before the App Store submission (broad
# scopes are deprecated as of Mar 2026 — confirm exact names on developer.xero.com).
# XERO_SCOPES=offline_access openid profile email accounting.settings accounting.contacts accounting.transactions

# ---- LLM: Azure AI Foundry via the OpenAI SDK (mapping/ingest/matching engines) ----
# LLM_PROVIDER=azure uses the AzureOpenAI client below; =openai uses OPENAI_* for a
# plain OpenAI-compatible endpoint (OpenAI, DeepSeek, a Foundry serverless URL, ...).
LLM_PROVIDER=azure

AZURE_OPENAI_ENDPOINT=            # https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=         # the model deployment name (e.g. gpt-4o)

# Generic OpenAI-compatible fallback (only used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o

# ---- Token encryption at rest ----
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CANOPY_FERNET_KEY=

# ---- Storage ----
DATABASE_URL=sqlite:///./canopy.sqlite3

# ---- Misc ----
SNAPSHOT_TTL_SECONDS=300
FRONTEND_ORIGIN=http://localhost:3000
