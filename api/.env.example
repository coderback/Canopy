# Copy to api/.env (gitignored) and fill in.

ENVIRONMENT=development

# App connects as the non-owner role (row-level security applies);
# migrations run as the owner. Matches docker-compose's `db` service.
DATABASE_URL=postgresql+psycopg://canopy_app:canopy_app@localhost:5432/canopy
MIGRATIONS_DATABASE_URL=postgresql+psycopg://canopy:canopy@localhost:5432/canopy

API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# Xero app: redirect URI http://localhost:8000/auth/xero/callback
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Comma-separated Fernet keys, newest first. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEYS=

COOKIE_SECURE=false

# LLM for mapping suggestions: azure_ad | azure | openai
LLM_PROVIDER=azure_ad
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o
